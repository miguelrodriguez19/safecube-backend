<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <dependencyManagement>
        <dependencies>
            <!-- ====== Spring Boot BOM ====== -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <groupId>com.miguelrodriguez19.safecube</groupId>
    <artifactId>safecube-backend</artifactId>
    <version>0.0.19-SNAPSHOT</version>

    <name>SafeCube Backend</name>
    <description>Core backend service for SafeCube</description>
    <url>https://github.com/miguelrodriguez19/safecube-backend</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>miguelrodriguez19</id>
            <name>Miguel Rodriguez</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/miguelrodriguez19/safecube-backend.git</connection>
        <developerConnection>scm:git:https://github.com/miguelrodriguez19/safecube-backend.git</developerConnection>
        <url>https://github.com/miguelrodriguez19/safecube-backend</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <spring-boot.version>4.0.1</spring-boot.version>
        <java.version>21</java.version>
        <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>

        <!-- execution flags -->
        <skip.surefire>false</skip.surefire>
        <skip.failsafe>false</skip.failsafe>
        <skip.docker>true</skip.docker>
        <skip.pitest>true</skip.pitest>

        <!-- Explicit versions for non-Spring-managed dependencies -->
        <antlr4-runtime.version>4.13.2</antlr4-runtime.version>
        <archunit.version>1.4.1</archunit.version>
        <google-java-format.version>1.21.0</google-java-format.version>
        <jjwt.version>0.13.0</jjwt.version>
        <karate.version>1.5.2</karate.version>
        <maven-exec.version>3.6.2</maven-exec.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.5.2</maven.failsafe.plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <pitest.version>1.22.0</pitest.version>
        <pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
        <spotless-maven-plugin.version>3.0.0</spotless-maven-plugin.version>
        <springdoc-openapi-starter-webmvc-ui.version>3.0.1</springdoc-openapi-starter-webmvc-ui.version>
    </properties>

    <dependencies>

        <!-- ======================= -->
        <!-- Spring Boot - Runtime   -->
        <!-- ======================= -->

        <!-- REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Security (JWT, filters, auth) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (Jakarta Validation / Hibernate Validator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator (health, metrics - minimal exposure) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok (compile-time only) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ANTRL -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr4-runtime.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- OpenApi -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi-starter-webmvc-ui.version}</version>
        </dependency>

        <!-- ======================= -->
        <!-- Testing & Quality       -->
        <!-- ======================= -->

        <!-- Spring Boot test stack (JUnit 5, Mockito, Spring Test) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Architecture tests -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Acceptance tests (HTTP, E2E) -->
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers (PostgreSQL for integration tests) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>safecube-backend</finalName>

        <pluginManagement>
            <plugins>

                <!-- Compiler -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>

                <!-- Surefire -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <skipTests>${skip.surefire}</skipTests>
                        <includes>
                            <include>architecture/**/*Test</include>
                            <include>unit/**/*Test</include>
                        </includes>
                        <excludes>
                            <exclude>integration/**/*IntegrationTest</exclude>
                            <exclude>acceptance/**/*Test</exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!-- Failsafe -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin.version}</version>
                    <configuration>
                        <skipITs>${skip.failsafe}</skipITs>
                        <includes>
                            <include>integration/**/*IntegrationTest</include>
                        </includes>
                    </configuration>
                </plugin>

                <!-- PIT -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest.junit5.plugin.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <skip>${skip.pitest}</skip>
                        <targetClasses>
                            <param>com.miguelrodriguez19.safecube.*</param>
                        </targetClasses>
                        <targetTests>
                            <param>unit.*</param>
                        </targetTests>
                        <threads>4</threads>
                        <coverageThreshold>0</coverageThreshold>
                    </configuration>
                </plugin>

                <!-- Docker orchestration -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${maven-exec.version}</version>

                    <configuration>
                        <skip>${skip.docker}</skip>
                        <environmentVariables>
                            <DOCKER_IMAGE>${project.artifactId}</DOCKER_IMAGE>
                        </environmentVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- compiler -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <classifier>executable</classifier>
                    <mainClass>com.miguelrodriguez19.safecube.SafeCubeBackendApplication</mainClass>
                    <layout>JAR</layout>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Unit tests -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Integration tests -->
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- PIT -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.plugin.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${skip.pitest}</skip>

                    <targetClasses>
                        <param>com.miguelrodriguez19.safecube.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>unit.com.miguelrodriguez19.safecube.*</param>
                    </targetTests>
                    <excludedClasses>
                        <excludedClass>*Controller</excludedClass>
                        <excludedClass>*ExceptionHandler</excludedClass>
                        <excludedClass>*Config</excludedClass>
                        <excludedClass>*Configuration</excludedClass>
                        <excludedClass>*Mapper</excludedClass>
                        <excludedClass>*Exception</excludedClass>
                    </excludedClasses>

                    <threads>4</threads>

                    <mutationThreshold>85</mutationThreshold>

                    <jvmArgs>
                        <param>-Xmx1G</param>
                        <param>--add-opens</param>
                        <param>java.base/java.lang=ALL-UNNAMED</param>
                        <param>--add-opens</param>
                        <param>java.base/java.util=ALL-UNNAMED</param>
                    </jvmArgs>

                    <verbose>true</verbose>
                </configuration>
            </plugin>

            <!-- Spotless -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>source-code</id>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <java>
                                <includes>
                                    <include>src/main/java/**/*.java</include>
                                    <include>src/test/java/**/*.java</include>
                                </includes>
                                <googleJavaFormat>
                                    <version>${google-java-format.version}</version>
                                </googleJavaFormat>
                                <removeUnusedImports/>
                                <formatAnnotations/>
                            </java>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Docker orchestration executions (enabled via profile) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>

                <executions>

                    <execution>
                        <id>docker-down-before</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>compose</argument>
                                <argument>-f</argument>
                                <argument>docker-compose.yml</argument>
                                <argument>down</argument>
                                <argument>-v</argument>
                                <argument>--rmi</argument>
                                <argument>local</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>docker-pull</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>compose</argument>
                                <argument>-f</argument>
                                <argument>docker-compose.yml</argument>
                                <argument>pull</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>docker-up</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>compose</argument>
                                <argument>-f</argument>
                                <argument>docker-compose.yml</argument>
                                <argument>up</argument>
                                <argument>-d</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>wait-for-backend</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    until curl -sf http://localhost:8080/safecube/actuator/health; do sleep 1; done
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>docker-down-after</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>compose</argument>
                                <argument>-f</argument>
                                <argument>docker-compose.yml</argument>
                                <argument>down</argument>
                                <argument>-v</argument>
                                <argument>--rmi</argument>
                                <argument>local</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy resources to classpath -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-db-schema-for-tests</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.testOutputDirectory}/autogenerated</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>docker/postgres</directory>
                                    <includes>
                                        <include>init-schema.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- ======================= -->
    <!-- Maven Profiles          -->
    <!-- ======================= -->
    <profiles>

        <!-- ========= acceptance =========
             Orchestrate docker and run
             integration & acceptance tests
             ============================== -->
        <profile>
            <id>acceptance</id>

            <properties>
                <skip.docker>false</skip.docker>
            </properties>

            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>integration/**/*IntegrationTest</include>
                                <include>acceptance/*Test</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>


        <!-- ========= acceptance-only =========
             Orchestrate docker and run only
             acceptance tests (no unit, arch or
             integration)
             =================================== -->
        <profile>
            <id>acceptance-only</id>

            <properties>
                <skip.surefire>true</skip.surefire>
                <skip.failsafe>false</skip.failsafe>
                <skip.pitest>true</skip.pitest>
                <skip.docker>false</skip.docker>
            </properties>

            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <skipITs>false</skipITs>

                            <includes combine.self="override">
                                <include>acceptance/**/*Test</include>
                            </includes>

                            <excludes combine.self="override">
                                <exclude>integration/**/*IntegrationTest</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>


        <!-- =========== Mutation ===========
             Runs only mutations test
             ================================ -->
        <profile>
            <id>mutation</id>

            <properties>
                <!-- Enable PIT -->
                <skip.pitest>false</skip.pitest>

                <!-- Unit tests MUST run for PIT -->
                <skip.surefire>false</skip.surefire>

                <!-- Disable everything else -->
                <skip.failsafe>true</skip.failsafe>
                <skip.docker>true</skip.docker>
            </properties>
        </profile>
    </profiles>
</project>
